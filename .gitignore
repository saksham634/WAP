# =============================================================================
# WAP (Workforce Automation Portal) - Root .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (CONFIDENTIAL - NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.secret
*.pem
*.key
*.p12
*.pfx
*.sql
!**/db/migration/*.sql
secrets.properties
application-local.properties
application-secret.properties
application-prod.properties

# -----------------------------------------------------------------------------
# Node & Frontend Build Artifacts
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.next/
out/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Java & Spring Boot Maven Artifacts
# -----------------------------------------------------------------------------
target/
WAP-Backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper jar if needed to exclude
.mvn/wrapper/maven-wrapper.jar

# -----------------------------------------------------------------------------
# IDE, Editor & Tooling Files
# -----------------------------------------------------------------------------
# Eclipse
.classpath
.project
.settings/
.factorypath
WAP-Backend/.classpath
WAP-Backend/.project
WAP-Backend/.settings/
WAP-Backend/.factorypath

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.built-jar.properties

# -----------------------------------------------------------------------------
# Operating System & Temporary Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
